rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {uid}
    // Fields:
    //   - uid: string (required) - User's unique ID
    //   - displayName: string (optional) - User's display name
    //   - email: string (required) - User's email address
    //   - photoURL: string (optional) - User's profile photo URL
    //   - role: string (optional) - User's role (admin/user)
    //   - updatedAt: timestamp (required) - Last update time
    //
    // Collection: bookings
    // Document ID: auto-generated
    // Fields:
    //   - uid: string (required) - ID of the user who made the booking
    //   - serviceType: string (required) - Type of service requested
    //   - message: string (required) - Additional details from the user
    //   - status: string (required) - Current status of the booking
    //   - createdAt: timestamp (required) - Time the booking was created
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "vivaann006@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt']) &&
             data.uid is string &&
             data.email is string &&
             data.email.size() < 100 &&
             data.updatedAt is timestamp;
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['uid', 'serviceType', 'message', 'status', 'createdAt']) &&
             data.uid == request.auth.uid &&
             data.serviceType is string &&
             data.serviceType.size() < 100 &&
             data.message is string &&
             data.message.size() < 1000 &&
             data.status in ['pending', 'confirmed', 'completed', 'cancelled'] &&
             data.createdAt is timestamp;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) && isValidUser(request.resource.data) && 
                              (!('role' in request.resource.data) || request.resource.data.role == 'user' || isAdmin());
    }

    match /bookings/{bookingId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidBooking(request.resource.data);
      allow update: if (isDocOwner() || isAdmin()) && isValidBooking(request.resource.data) && 
                      request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isDocOwner() || isAdmin();
    }
  }
}
